<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <OutputType>Library</OutputType>
        <Nullable>enable</Nullable>
        <ImplicitUsings>disable</ImplicitUsings>
        <Version>1.0.1</Version>
        <RootNamespace>Shoko.Plugin.Oidc</RootNamespace>
        <AssemblyName>Shoko.Plugin.Oidc</AssemblyName>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Shoko.Abstractions" Version="6.0.0-alpha.97" ExcludeAssets="runtime" />
        <PackageReference Include="Shoko.BuildTools.Targets" Version="0.3.0" PrivateAssets="All" ExcludeAssets="runtime" />
    </ItemGroup>

    <ItemGroup>
        <EmbeddedResource Include="Pages\admin.html" LogicalName="Shoko.Plugin.Oidc.Pages.admin.html" />
    </ItemGroup>
</Project>
